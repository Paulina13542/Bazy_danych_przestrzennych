FACTORY_DEF {*} ExecuteFunctionFactory    FACTORY_NAME { _length_LengthCalculator }    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT  FEATURE_TYPE AttributeCreator_4_OUTPUT_1_zSwxowmf2A4=    INPUT  FEATURE_TYPE AttributeCreator_OUTPUT_1_qtO51pc0PKY=    FUNCTION_DEFINITION { @Length(REJECTABLE,2,"1") }    RESULT_ATTRIBUTE { "_length" }    OUTPUT { COMPLETE FEATURE_TYPE _length_OUTPUT        }
